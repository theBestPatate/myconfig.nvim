#!/bin/bash
# Pre-commit hook: format staged Lua files with stylua, then re-stage them.
# Requires stylua on PATH (mason bin or system install).

STYLUA="$(which stylua 2>/dev/null || echo "$HOME/.local/share/nvim/mason/bin/stylua")"

if [ ! -x "$STYLUA" ]; then
  echo "pre-commit: stylua not found at $STYLUA — skipping"
  exit 0
fi

# Collect staged .lua files (if any were deleted, skip them)
staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.lua')
if [ -z "$staged" ]; then
  exit 0
fi

echo "$staged" | while read -r file; do
  "$STYLUA" "$file"
  git add "$file"
done
